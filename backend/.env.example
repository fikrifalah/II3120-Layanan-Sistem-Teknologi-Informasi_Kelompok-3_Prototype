# Salin ke backend/.env lalu isi nilai yang ditandai. backend/.env tidak boleh di-commit.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://gigly:gigly@localhost:5432/gigly
# Database terpisah khusus pytest; tiap tes memakai schema sementara sendiri
TEST_DATABASE_URL=postgresql+psycopg://gigly:gigly@localhost:5432/gigly_test

# --- AI Matching (OpenRouter; satu API key untuk LLM dan embedding) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Wajib sama saat indexing CV (seed_db.py) dan saat matching
EMBEDDING_MODEL=baai/bge-m3

# --- Blockchain (Hardhat lokal; alamat dari `npm run deploy`, key = akun uji Hardhat) ---
RPC_URL=http://127.0.0.1:8545
SIMIDR_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ESCROW_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
PLATFORM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ARBITER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Opsional: mnemonic wallet per user (default: mnemonic bawaan Hardhat)
# DEV_WALLET_MNEMONIC=

# --- Orchestrator ---
# Cek auto-release milestone (detik); 0 = mati
AUTO_RELEASE_INTERVAL_SECONDS=60
