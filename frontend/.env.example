VITE_API_BASE_URL=http://localhost:8000/api/v1
# Set to false to call the real backend instead of the built-in mock data
VITE_USE_MOCK=false
# AI matching asli dari backend (fitur lain tetap mengikuti VITE_USE_MOCK)
VITE_MATCHING_API=true
# Akun client di backend yang dipakai sebagai pemilik proyek selama login masih mock (1 = Rina Kusuma)
VITE_MATCHING_CLIENT_ID=1
# Login asli dari backend (akun di database, password prototype 1234)
VITE_AUTH_API=true
# Profil freelancer dari backend (edit profil = indeks ulang CV untuk matching)
VITE_PROFILE_API=true
# Undangan lewat backend (client mengundang alias, freelancer menerima, identitas dibuka)
VITE_INVITATIONS_API=true
